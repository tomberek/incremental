#!/usr/bin/env bash
# nix-ninja — like `ninja`, but wraps the build in nixgg placeholder+force.
#
# Usage:
#   nix-ninja [ninja-flags...] [TARGETS...]
#
# For each requested target, resolves it to real-file outputs via
# `ninja -t query`. Phony targets are followed to their inputs
# recursively; real-file targets stand for themselves.

set -euo pipefail

_here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
"$_here/nixgg" env >/dev/null

# Split ninja flags from targets. Ninja options that take an arg:
#   -j -k -l -d -t -f -C
# Everything else that starts with `-` is a boolean flag.
#
# `-C DIR` (change directory) and `-f FILE` (explicit build file) also
# affect which build.ninja `-t query` reads; capture them separately so
# we can pass them to inspection calls as well as the final build.
flags=()
targets=()
change_dir=""
i=0
argv=("$@")
n=${#argv[@]}
while (( i < n )); do
  a="${argv[i]}"
  case "$a" in
    -C)
      # Absorb -C DIR — we handle the cd ourselves so nixgg's target
      # paths and ninja's -t query are consistent.
      change_dir="${argv[i+1]:-}"; i=$((i+2)); continue ;;
    -f)
      flags+=( "$a" "${argv[i+1]:-}" ); i=$((i+2)); continue ;;
    -j|-k|-l|-d|-t)
      flags+=( "$a" "${argv[i+1]:-}" ); i=$((i+2)); continue ;;
    -*)
      flags+=( "$a" ); i=$((i+1)); continue ;;
    *)
      targets+=( "$a" ); i=$((i+1)); continue ;;
  esac
done

[[ -n "$change_dir" ]] && cd "$change_dir"

# Walk from a ninja target to its real-file build products.
#
# `ninja -t query T` output shape:
#   T:
#     input: <rulename>         ← "phony" for aliases, else a real rule
#       <input dependency>      ← for real-rule targets: the sources
#       <input dependency>      ← for phony: the real files T stands for
#     outputs:
#       <downstream target>     ← things that depend on T; NOT T's outputs
#
# For a real-file target (rulename != phony) the target *is* its own
# output — return it. For a phony target the `input:` block enumerates
# the real files it stands for; recurse into each.
_query_outputs() {
  local t="$1"
  local q
  q=$(ninja -t query "$t" 2>/dev/null || true)
  [[ -z "$q" ]] && return
  local rulename
  rulename=$(awk '/^  input:/ { print $2; exit }' <<<"$q")
  if [[ "$rulename" != phony ]]; then
    printf '%s\n' "$t"
    return
  fi
  local inputs i
  inputs=$(awk '
    /^  input:/  { in_inputs=1; next }
    /^  outputs:/ { in_inputs=0 }
    in_inputs && /^    / { sub(/^    +/, ""); print }
  ' <<<"$q")
  while IFS= read -r i; do
    [[ -z "$i" ]] && continue
    _query_outputs "$i"
  done <<<"$inputs"
}

_targets_to_resolve=()
if (( ${#targets[@]} == 0 )); then
  # No user-specified target → ninja's defaults.
  while IFS=: read -r name _; do
    [[ -n "$name" ]] && _targets_to_resolve+=( "$name" )
  done < <(ninja -t targets 2>/dev/null)
else
  _targets_to_resolve=( "${targets[@]}" )
fi

discovered=()
for t in "${_targets_to_resolve[@]}"; do
  while IFS= read -r line; do
    [[ -n "$line" ]] && discovered+=( "$line" )
  done < <(_query_outputs "$t")
done

# Deduplicate, order-preserving.
declare -A seen=()
final=()
for t in "${discovered[@]}"; do
  [[ -z "${seen[$t]:-}" ]] || continue
  seen["$t"]=1
  final+=( "$t" )
done

if (( ${#final[@]} == 0 )); then
  echo "nix-ninja: no file targets discovered; falling back to realise mode" >&2
  cmd=( "$_here/nixgg" run -- ninja )
  (( ${#flags[@]}   )) && cmd+=( "${flags[@]}" )
  (( ${#targets[@]} )) && cmd+=( "${targets[@]}" )
  exec "${cmd[@]}"
fi

target_args=()
for t in "${final[@]}"; do
  target_args+=( --target "$t" )
done

cmd=( "$_here/nixgg" build "${target_args[@]}" -- ninja )
(( ${#flags[@]}   )) && cmd+=( "${flags[@]}" )
(( ${#targets[@]} )) && cmd+=( "${targets[@]}" )
exec "${cmd[@]}"
