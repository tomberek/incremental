#!/usr/bin/env bash
# nix-make — like `make`, but wraps the build in nixgg placeholder+force.
#
# Usage:
#   nix-make [make-flags...] [TARGETS...]
#
# Discovers which files `make TARGETS` would produce by scanning
# `make -n TARGETS` for `-o <file>` outputs, then passes those to
# `nixgg build --target …` alongside the real `make` invocation.
# Phony targets (`all`, `install`, etc.) are handled transitively: we
# force whatever real files appear in the dry-run.
#
# With no targets, `make -n` reports the default rule's actions.

set -euo pipefail

_here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

# Bootstrap NIXGG_* if the caller hasn't. Needed before `make -n`
# because that invocation will spawn our shims for rule inspection.
"$_here/nixgg" env >/dev/null

# Separate make flags from targets. Order-preserving.
# Absorb `-C DIR` (or `--directory=DIR`) here so we chdir once and
# everything else (make -n dry-run and the eventual build) sees the
# same cwd. This keeps target paths consistent with nixgg's view.
flags=()
targets=()
change_dir=""
argv=( "$@" )
i=0
n=${#argv[@]}
while (( i < n )); do
  a="${argv[i]}"
  case "$a" in
    -C)             change_dir="${argv[i+1]:-}"; i=$((i+2)); continue ;;
    --directory=*)  change_dir="${a#--directory=}"; i=$((i+1)); continue ;;
    -*|*=*)         flags+=( "$a" ); i=$((i+1)); continue ;;
    *)              targets+=( "$a" ); i=$((i+1)); continue ;;
  esac
done

[[ -n "$change_dir" ]] && cd "$change_dir"

# ── Discover which files `make TARGETS` would actually produce ─────
_discover_outputs() {
  local cmd=( make -n )
  (( ${#flags[@]}   )) && cmd+=( "${flags[@]}" )
  (( ${#targets[@]} )) && cmd+=( "${targets[@]}" )
  "${cmd[@]}" 2>/dev/null \
    | awk '
        # -o FILE (compile / link output).
        {
          for (i = 1; i < NF; i++) {
            if ($i == "-o") { print $(i+1); }
          }
        }
        # `ar <mode> archive.a ...` — archive is the 3rd word after ar.
        # Modes are non-flag tokens like `cru`, `rcs`, `qc`, `Dcru`.
        {
          for (i = 1; i <= NF-2; i++) {
            if ($i == "ar" || $i ~ /\/ar$/) {
              mode = $(i+1)
              # Skip leading `-` if present.
              sub(/^-/, "", mode)
              # Modes are 1+ chars from [cruvsDxtpqRUb].
              if (mode ~ /^[cruvsDxtpqRUb]+$/) print $(i+2)
            }
          }
        }
      ' \
    | awk '!seen[$0]++'
}

discovered=()
while IFS= read -r line; do
  [[ -n "$line" ]] && discovered+=( "$line" )
done < <(_discover_outputs)

if (( ${#discovered[@]} == 0 )); then
  # Nothing to force — likely a phony rule that runs a real make later.
  # Just run make under nixgg's shims in realise mode.
  echo "nix-make: no -o outputs discovered; falling back to realise mode" >&2
  cmd=( "$_here/nixgg" run -- make )
  (( ${#flags[@]}   )) && cmd+=( "${flags[@]}" )
  (( ${#targets[@]} )) && cmd+=( "${targets[@]}" )
  exec "${cmd[@]}"
fi

# ── Build ──────────────────────────────────────────────────────────
# Force ALL discovered outputs. nixgg force is a no-op on
# already-realised symlinks, so this is safe and avoids a
# "which target is the root?" analysis.
target_args=()
for t in "${discovered[@]}"; do
  target_args+=( --target "$t" )
done

cmd=( "$_here/nixgg" build "${target_args[@]}" -- make )
(( ${#flags[@]}   )) && cmd+=( "${flags[@]}" )
(( ${#targets[@]} )) && cmd+=( "${targets[@]}" )
"${cmd[@]}"

# Some rules hide their output from `make -n` — cmake's Make generator
# invokes `ar` inside `cmake_link_script`, so the archive line never
# appears in the dry-run. Find those "root" thunks (not imported by
# any other thunk) and force them too.
thunks_dir="${NIXGG_THUNKS_DIR:-$PWD/.nixgg/thunks}"
symlinks_dir="${NIXGG_SYMLINKS_DIR:-$(dirname "$thunks_dir")/symlinks}"
if [[ -d "$thunks_dir" && -d "$symlinks_dir" ]]; then
  # Build the set of referenced thunk ids (regex over all thunk files).
  referenced=$(grep -horE '/thunks/[a-f0-9]+\.nix' "$thunks_dir"/*.nix 2>/dev/null \
                 | sed 's|^/thunks/||; s|\.nix$||' | sort -u)
  root_targets=()
  for tid_file in "$symlinks_dir"/*; do
    [[ -f "$tid_file" ]] || continue
    tid=$(basename "$tid_file")
    if ! grep -qxF "$tid" <<<"$referenced"; then
      # Root thunk — pick one of its symlinks to force.
      first_sym=$(head -1 "$tid_file")
      [[ -L "$first_sym" ]] && root_targets+=( "$first_sym" )
    fi
  done
  if (( ${#root_targets[@]} )); then
    "$_here/nixgg" force "${root_targets[@]}"
  fi
fi
