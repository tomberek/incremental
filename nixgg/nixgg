#!/usr/bin/env bash
# nixgg — one-command wrapper around the shims/driver/force machinery.
#
# Subcommands:
#   run    — run a command with nixgg shims (realise mode).
#   eval   — same, but placeholder mode: shims write thunks.
#   force  — realise the .nix thunks pointed at by target symlinks.
#   build  — eval + force in one shot.
#   emit   — print a Nix expression realising the target either
#            directly or via a builder-rpc-v0 outer derivation
#            (NixOS/nix PR 15793).
#   stats  — summarise an NIXGG_LOG ndjson activity file.
#   env    — print `export …` lines for shims-on-PATH.
#
# Auto-bootstraps: if any NIXGG_* env var is missing when a subcommand
# needs it, we build .#env-shell from the flake and source it. Only
# hard requirement is a `nix` binary on PATH (or via BOOTSTRAP_NIX).

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
export NIXGG_ROOT="${NIXGG_ROOT:-$HERE}"

# ── Bootstrap: populate NIXGG_* env from the flake's .#env-shell ────
# Idempotent — if every required var is already set, this is a no-op.
# Requires a `nix` on PATH (or $BOOTSTRAP_NIX) for the first call.
_nixgg_all_set() {
  [[ -n "${NIXGG_REAL_CC:-}"           ]] \
    && [[ -n "${NIXGG_NIX:-}"           ]] \
    && [[ -n "${NIXGG_STORE:-}"         ]] \
    && [[ -n "${NIXGG_COMPILER_ROOT:-}" ]] \
    && [[ -n "${NIXGG_BASH_ROOT:-}"     ]] \
    && [[ -n "${NIXGG_COREUTILS_ROOT:-}" ]] \
    && [[ -n "${NIXGG_NIX_HELPERS:-}"   ]]
}

_nixgg_bootstrap() {
  _nixgg_all_set && return 0

  local bootstrap_nix="${BOOTSTRAP_NIX:-$(command -v nix || true)}"
  if [[ -z "$bootstrap_nix" ]]; then
    echo "nixgg: NIXGG_* env vars unset and no \`nix\` on PATH. Install nix or set BOOTSTRAP_NIX." >&2
    return 1
  fi

  local env_file
  if ! env_file=$( (cd "$NIXGG_ROOT" && \
        "$bootstrap_nix" build .#env-shell --no-link --print-out-paths) \
        2> >(tee /dev/stderr) | tail -1); then
    echo "nixgg: failed to build .#env-shell" >&2
    return 1
  fi

  # shellcheck disable=SC1090
  set -a; . "$env_file"; set +a
  export NIXGG_ROOT
  : "${NIXGG_STORE:=local?root=${ALT_STORE:-/tmp/nixgg-store}}"
  export NIXGG_STORE

  case "$NIXGG_STORE" in
    auto|daemon) ;;
    *)
      if [[ -n "${NIXGG_TOOLCHAIN_PATHS:-}" ]]; then
        # shellcheck disable=SC2086
        "$bootstrap_nix" copy --from daemon --to "$NIXGG_STORE" \
          --no-check-sigs $NIXGG_TOOLCHAIN_PATHS >/dev/null
      fi
      ;;
  esac
}

usage() {
  cat <<EOF
usage: nixgg <subcommand> [args…]

  run    [--mode realise|placeholder] [--thunks-dir DIR] -- <cmd…>
  eval   [--thunks-dir DIR] -- <cmd…>
  force  [--thunks-dir DIR] [--roots] [target…]
  build  --target FILE [--target FILE…] [--thunks-dir DIR] -- <cmd…>
  emit   <target…>            (writes to \$NIXGG_EMIT_OUT if set, else stdout)
  stats  [--since EPOCH] <log>
  env
EOF
}

# ── Argument helpers ───────────────────────────────────────────────

# Strip a leading `--` from a positional command list.
_drop_dashdash() {
  if [[ "${1:-}" == "--" ]]; then shift; fi
  printf '%s\n' "$@"
}

# Setup the per-child env for a shim-using subcommand and exec.
_child_env_prefix() {
  export NIXGG_ROOT
  export PATH="$HERE/shims:$PATH"
  export CC="${CC:-cc}"
  export CXX="${CXX:-c++}"
}

# ── Subcommand implementations ─────────────────────────────────────

cmd_run() {
  local mode=realise thunks_dir=""
  while (( $# > 0 )); do
    case "$1" in
      --mode)           mode="$2"; shift 2 ;;
      --thunks-dir)     thunks_dir="$(realpath -m "$2")"; shift 2 ;;
      --)               shift; break ;;
      -h|--help)        usage; return 0 ;;
      *)                break ;;
    esac
  done
  if (( $# == 0 )); then
    echo "nixgg run: no command given (use '-- <cmd> [args…]')" >&2
    return 2
  fi
  _nixgg_bootstrap
  _child_env_prefix
  export NIXGG_MODE="$mode"
  [[ -n "$thunks_dir" ]] && export NIXGG_THUNKS_DIR="$thunks_dir"
  exec "$@"
}

cmd_eval() {
  local thunks_dir=""
  while (( $# > 0 )); do
    case "$1" in
      --thunks-dir)     thunks_dir="$(realpath -m "$2")"; shift 2 ;;
      --)               shift; break ;;
      -h|--help)        usage; return 0 ;;
      *)                break ;;
    esac
  done
  if (( $# == 0 )); then
    echo "nixgg eval: no command given (use '-- <cmd> [args…]')" >&2
    return 2
  fi
  _nixgg_bootstrap
  _child_env_prefix
  export NIXGG_MODE=placeholder
  [[ -n "$thunks_dir" ]] && export NIXGG_THUNKS_DIR="$thunks_dir"
  exec "$@"
}

cmd_force() {
  local thunks_dir="" roots_mode=0
  while (( $# > 0 )); do
    case "$1" in
      --thunks-dir)     thunks_dir="$(realpath -m "$2")"; shift 2 ;;
      --roots)          roots_mode=1; shift ;;
      -h|--help)        usage; return 0 ;;
      *)                break ;;
    esac
  done
  if (( $# == 0 )) && (( ! roots_mode )); then
    echo "nixgg force: no targets given (or pass --roots)" >&2
    return 2
  fi
  _nixgg_bootstrap
  _child_env_prefix
  [[ -n "$thunks_dir" ]] && export NIXGG_THUNKS_DIR="$thunks_dir"

  local _thunks_dir="${NIXGG_THUNKS_DIR:-$PWD/.nixgg/thunks}"
  local _symlinks_dir="${NIXGG_SYMLINKS_DIR:-$(dirname "$_thunks_dir")/symlinks}"

  # --roots: locate every thunk that no other thunk imports, then pick
  # one of its recorded symlinks as the target. Handles build systems
  # that hide outputs from dry-run (cmake's cmake_link_script → ar).
  if (( roots_mode )); then
    if [[ ! -d "$_thunks_dir" || ! -d "$_symlinks_dir" ]]; then
      # Nothing evaluated yet — no-op.
      (( $# > 0 )) || return 0
    else
      local referenced tid_file tid first_sym
      referenced=$(grep -horE '\./[a-f0-9]+\.nix' "$_thunks_dir"/*.nix 2>/dev/null \
                     | sed 's|^\./||; s|\.nix$||' | sort -u)
      for tid_file in "$_symlinks_dir"/*; do
        [[ -f "$tid_file" ]] || continue
        tid=$(basename "$tid_file")
        if ! grep -qxF "$tid" <<<"$referenced"; then
          first_sym=$(head -1 "$tid_file")
          [[ -L "$first_sym" ]] && set -- "$@" "$first_sym"
        fi
      done
    fi
    if (( $# == 0 )); then
      # Nothing to do.
      return 0
    fi
  fi

  # Each target is a symlink. If it points at a thunk `.nix`, build it
  # and re-target the symlink to the resulting /nix/store/... path. If
  # it already points at the store, nothing to do.
  export NIX_REMOTE=""
  export NIX_CONFIG="experimental-features = nix-command flakes ca-derivations
store = $NIXGG_STORE
"
  local alt_root=""
  case "$NIXGG_STORE" in
    local\?root=*) alt_root="${NIXGG_STORE#local?root=}" ;;
  esac

  _classify_target() {
    local t="$1"
    if [[ ! -e "$t" && ! -L "$t" ]]; then printf 'absent\n'; return; fi
    if [[ ! -L "$t" ]]; then printf 'regular\n'; return; fi
    local dest canonical trimmed
    dest=$(readlink -f "$t" 2>/dev/null || readlink "$t")
    canonical="$dest"
    if [[ -n "$alt_root" && "$dest" == "$alt_root"/nix/store/* ]]; then
      canonical="${dest#"$alt_root"}"
    fi
    case "$canonical" in
      /nix/store/*)
        trimmed="${canonical#/nix/store/}"
        trimmed="${trimmed%%/*}"
        printf 'store /nix/store/%s\n' "$trimmed"
        ;;
      *.nix)  printf 'thunk %s\n' "$dest" ;;
      *)      printf 'regular\n' ;;
    esac
  }

  local symlinks_dir="$_symlinks_dir"

  # Walk the transitive `import ./<id>.nix` references in a thunk file.
  # Prints each visited thunk `.nix` absolute path once. Bash lacks a
  # set, so we use an associative array.
  declare -A _seen=()
  _collect_thunks() {
    local t="$1"
    [[ -n "${_seen[$t]:-}" ]] && return
    _seen["$t"]=1
    printf '%s\n' "$t"
    # Thunks import their siblings by relative path (import ./<id>.nix)
    # so we resolve each against the current thunk's directory.
    local dir tid_ref child
    dir=$(dirname "$t")
    while IFS= read -r tid_ref; do
      child="$dir/$tid_ref"
      [[ -f "$child" ]] || continue
      _collect_thunks "$child"
    done < <(grep -oE '\./[a-f0-9]+\.nix' "$t" 2>/dev/null | sort -u | sed 's|^\./||')
  }

  # Register a GC root for a store path (used from force promotion).
  # Alt-store: nested gcroots under the alt-store root. System store:
  # per-user gcroots under /nix/var/nix/gcroots.
  _register_gcroot() {
    local store_path="$1" target="$2"
    local root_dir
    if [[ -n "$alt_root" ]]; then
      root_dir="$alt_root/nix/var/nix/gcroots/per-user/${USER:?}/nixgg"
    else
      root_dir="/nix/var/nix/gcroots/per-user/${USER:?}/nixgg"
    fi
    mkdir -p "$root_dir" 2>/dev/null || return 0
    [[ -w "$root_dir" ]] || return 0
    local key
    key=$(printf '%s' "$(realpath -m --no-symlinks "$target")" | sha1sum | cut -c1-32)
    ln -sfn "$store_path" "$root_dir/$key"
  }

  # Promote every caller-visible symlink recorded against a thunk.
  # Called after we've realised the thunk (so its outPath is available
  # via a fresh eval — cheap since Nix's eval cache is hot).
  _promote_thunk_symlinks() {
    local thunk="$1"
    local tid_base tid manifest store_path sym
    tid_base="$(basename "$thunk")"
    tid="${tid_base%.nix}"
    manifest="$symlinks_dir/$tid"
    [[ -f "$manifest" ]] || return 0
    # `nix build --print-out-paths` on a CA thunk gives us the
    # realised store path. Already-built thunks return instantly.
    # (Plain `nix eval` returns a placeholder for CA outputs.)
    store_path=$("$NIXGG_NIX" build --no-link --print-out-paths \
                   --file "$thunk" 2>/dev/null | tail -1 || true)
    [[ "$store_path" == /nix/store/* ]] || return 0
    local src
    while IFS= read -r sym; do
      [[ -z "$sym" ]] && continue
      [[ -L "$sym" ]] || continue  # user deleted it — leave alone
      # Skip if already store-linked (idempotent).
      dest_now=$(readlink "$sym")
      [[ "$dest_now" == *.nix ]] || continue
      src="$alt_root$store_path/$(basename "$sym")"
      [[ -e "$src" ]] || continue
      ln -sfn "$src" "$sym"
      _register_gcroot "$store_path" "$sym"
      echo "[nixgg force] $sym -> $store_path" >&2
    done < "$manifest"
  }

  local rc=0 target kind ref store_path src
  for target in "$@"; do
    read -r kind ref < <(_classify_target "$target")
    case "$kind" in
      thunk)
        # Realise the target's whole graph in one nix build.
        store_path=$("$NIXGG_NIX" build --no-link --print-out-paths \
                      --file "$ref" | tail -1)
        src="$alt_root$store_path/$(basename "$target")"
        if [[ ! -e "$src" ]]; then
          echo "expected $src after build" >&2
          rc=1; continue
        fi
        ln -sfn "$src" "$target"
        _register_gcroot "$store_path" "$target"
        echo "[nixgg force] $target -> $store_path" >&2

        # Promote every symlink of every transitive thunk we just
        # realised. All the store paths are already in the alt store
        # (nix build populated them); we only need to update symlinks.
        _seen=()
        while IFS= read -r t; do
          _promote_thunk_symlinks "$t"
        done < <(_collect_thunks "$ref")
        ;;
      store)
        echo "[nixgg force] $target already realised ($ref)" >&2
        ;;
      absent)
        echo "no target $target" >&2
        rc=1
        ;;
      regular)
        echo "$target is not a nixgg symlink" >&2
        rc=1
        ;;
    esac
  done
  return $rc
}

cmd_build() {
  local thunks_dir="" targets=()
  while (( $# > 0 )); do
    case "$1" in
      --target)         targets+=( "$2" ); shift 2 ;;
      --thunks-dir)     thunks_dir="$(realpath -m "$2")"; shift 2 ;;
      --)               shift; break ;;
      -h|--help)        usage; return 0 ;;
      *)                break ;;
    esac
  done
  if (( ${#targets[@]} == 0 )); then
    echo "nixgg build: at least one --target is required" >&2
    return 2
  fi
  if (( $# == 0 )); then
    echo "nixgg build: no build command (use '-- <cmd> [args…]')" >&2
    return 2
  fi

  _nixgg_bootstrap
  _child_env_prefix
  # Pin thunks-dir to $PWD/.nixgg/thunks (or the caller's override) so
  # recursive submakes don't scatter thunks across per-subdir defaults.
  export NIXGG_THUNKS_DIR="${thunks_dir:-$PWD/.nixgg/thunks}"

  echo "[nixgg build] eval: $*" >&2
  ( export NIXGG_MODE=placeholder; "$@" )
  local rc=$?
  if (( rc != 0 )); then
    echo "[nixgg build] eval failed (rc=$rc)" >&2
    return $rc
  fi

  echo "[nixgg build] force: ${targets[*]}" >&2
  cmd_force "${targets[@]}"
}

# ── nixgg emit ────────────────────────────────────────────────────
# Given one or more targets that are currently `NIX:<thunk>` symlinks,
# generate a self-contained Nix expression that realises the same graph
# — with two attributes:
#   .direct     — build via the existing thunk (works today).
#   .sandboxed  — same result via a `builder-rpc-v0` outer derivation
#                 (needs NixOS/nix PR 15793).
# Prints the expression to stdout, or writes to $NIXGG_EMIT_OUT.
cmd_emit() {
  while (( $# > 0 )); do
    case "$1" in
      -h|--help) usage; return 0 ;;
      *)         break ;;
    esac
  done
  if (( $# == 0 )); then
    echo "nixgg emit: no targets given" >&2
    return 2
  fi
  _nixgg_bootstrap

  # Resolve each target to its underlying thunk .nix path (same
  # classify logic as cmd_force).
  local alt_root=""
  case "$NIXGG_STORE" in
    local\?root=*) alt_root="${NIXGG_STORE#local?root=}" ;;
  esac
  _classify_target() {
    local t="$1" dest canonical trimmed
    if [[ ! -e "$t" && ! -L "$t" ]]; then printf 'absent\n'; return; fi
    if [[ ! -L "$t" ]]; then printf 'regular\n'; return; fi
    dest=$(readlink -f "$t" 2>/dev/null || readlink "$t")
    canonical="$dest"
    if [[ -n "$alt_root" && "$dest" == "$alt_root"/nix/store/* ]]; then
      canonical="${dest#"$alt_root"}"
    fi
    case "$canonical" in
      /nix/store/*)
        trimmed="${canonical#/nix/store/}"; trimmed="${trimmed%%/*}"
        printf 'store /nix/store/%s\n' "$trimmed" ;;
      *.nix)  printf 'thunk %s\n' "$dest" ;;
      *)      printf 'regular\n' ;;
    esac
  }

  local out
  out=$(cat <<'HEADER'
# ─────────────────────────────────────────────────────────────────────
# Auto-generated by `nixgg emit`. Do not hand-edit.
#
# Two ways to realise the same target:
#
#   `.direct`     — imports the thunk graph directly. Same result as
#                   `nixgg force <target>`. Works on any Nix.
#
#   `.sandboxed`  — wraps the target in an outer builder-rpc-v0
#                   derivation and uses `nix store submit-output` to
#                   register the already-realised store path as its
#                   own `out`. Requires a Nix with PR 15793 merged
#                   (dynamic-derivations + builder-rpc-v0 features).
#
#                   `nixgg emit` realises the thunks out-of-sandbox
#                   before generating this file; the sandboxed drv
#                   just proves the RPC path works end-to-end.
# ─────────────────────────────────────────────────────────────────────
{
  pkgs ? import <nixpkgs> { },
}:

let
  bash      = pkgs.bash;
  coreutils = pkgs.coreutils;
  # `nix` inside the builder-rpc-v0 sandbox. Must be a build with
  # \`nix store submit-output\` (NixOS/nix PR 15793). We embed a
  # concrete store path here so the sandbox has the correct binary.
  # Override at emit time with \$NIXGG_PATCHED_NIX.
  nix       = builtins.storePath "$_NIXGG_PATCHED_NIX";
HEADER
)
  # Substitute the patched-nix store path (needed by the sandboxed
  # variant). Empty if unset → sandboxed variant will fail to build,
  # but direct still works.
  local patched="${NIXGG_PATCHED_NIX:-}"
  out="${out//\$_NIXGG_PATCHED_NIX/$patched}"
  out+=$'\n'

  # We need each target's store path for the sandboxed variant, so
  # realise ahead of time. This is cheap if the thunk is already built.
  local target thunk_path kind ref idx=0 store_path
  local targets=("$@")
  local direct_binds="" sandboxed_binds=""
  export NIX_REMOTE=""
  export NIX_CONFIG="experimental-features = nix-command flakes ca-derivations
store = $NIXGG_STORE
"
  for target in "${targets[@]}"; do
    read -r kind ref < <(_classify_target "$target")
    case "$kind" in
      thunk)
        thunk_path="$ref"
        # Realise the thunk so the sandboxed drv can reference its
        # output as a plain store path.
        store_path=$("$NIXGG_NIX" build --no-link --print-out-paths \
                      --file "$thunk_path" | tail -1)
        ;;
      store)
        store_path="$ref"
        thunk_path=""
        ;;
      *)
        echo "nixgg emit: $target isn't a nixgg symlink ($kind)" >&2
        return 1
        ;;
    esac
    local name; name=$(basename "$target")
    local attr="_$idx"
    if [[ -n "$thunk_path" ]]; then
      direct_binds+="    $attr = { name = \"$name\"; drv = import $thunk_path; };"$'\n'
    else
      direct_binds+="    $attr = { name = \"$name\"; drv = builtins.storePath \"$store_path\"; };"$'\n'
    fi
    sandboxed_binds+="    $attr = { name = \"$name\"; storePath = \"$store_path\"; };"$'\n'
    idx=$((idx+1))
  done

  out+=$(cat <<BODY
  # Targets that were passed to \`nixgg emit\`.  Each has:
  #   .name   — the caller-visible file name (e.g. "mosh-client")
  #   .drv    — the realised derivation (in \`.direct\`)
  #   .thunk  — the thunk .nix path (in \`.sandboxed\`)
  directTargets = {
$direct_binds  };
  sandboxedTargets = {
$sandboxed_binds  };

in {
  # Realises each target as the derivation defined by its thunk.
  direct = builtins.mapAttrs (_: t: t.drv) directTargets;

  # An outer builder-rpc-v0 derivation per target. This demonstrates
  # PR 15793's \`nix store submit-output\` mechanism: the target's
  # underlying store path is already-realised (\`nixgg emit\` builds
  # the thunk graph out-of-sandbox before printing). The sandboxed drv
  # simply hands the daemon that path via submit-output, and the
  # daemon accepts it as this drv's \`out\`.
  #
  # Building this variant proves that a builder-rpc-v0 sandbox can
  # register an output through the limited RPC socket. Extending to
  # "run the whole nixgg graph inside the sandbox" would need the
  # thunks + helpers to also be inside-store; kept as future work.
  sandboxed = builtins.mapAttrs (_: t:
    let
      # The submit-output RPC insists that the outer drv's name match
      # the store-path's name (the part after /nix/store/<hash>-).
      storePathName =
        let s = t.storePath;
            after = builtins.substring 44 (builtins.stringLength s) s;
        in after;
    in derivation {
    name = storePathName;
    system = builtins.currentSystem;

    __contentAddressed = true;
    outputHashMode = "nar";
    outputHashAlgo = "sha256";
    requiredSystemFeatures = [ "builder-rpc-v0" ];

    # Pass the already-realised store path through the env so Nix
    # copies its closure into the sandbox and we can reference it.
    inputStorePath = builtins.storePath t.storePath;
    outName = t.name;

    builder = "\${bash}/bin/bash";
    args = [ "-c" ''
      set -euo pipefail
      export PATH="\${coreutils}/bin:\${nix}/bin"
      export NIX_CONFIG='extra-experimental-features = nix-command ca-derivations dynamic-derivations'
      # submit-output takes the store path we already realised and
      # registers its \`\$outName\` file as this drv's \`out\`.
      nix store submit-output "\$inputStorePath" out
    '' ];
  }) sandboxedTargets;
}
BODY
)
  out+=$'\n'

  if [[ -n "${NIXGG_EMIT_OUT:-}" ]]; then
    printf '%s' "$out" > "$NIXGG_EMIT_OUT"
    echo "[nixgg emit] wrote $NIXGG_EMIT_OUT" >&2
  else
    printf '%s' "$out"
  fi
}

cmd_stats() {
  local since=0 log=""
  while (( $# > 0 )); do
    case "$1" in
      --since)   since="$2"; shift 2 ;;
      -h|--help) usage; return 0 ;;
      *)         log="$1"; shift ;;
    esac
  done
  if [[ -z "$log" ]]; then
    echo "usage: nixgg stats [--since <epoch>] <log-path>" >&2
    return 2
  fi
  [[ -f "$log" ]] || { echo "no such log: $log" >&2; return 1; }
  jq -s --argjson since "$since" -r '
    map(select((.ts // 0) >= $since)) as $events
    | ($events | group_by([.event, .kind])
               | map({ key: (.[0].event + " " + .[0].kind), n: length })
               | sort_by(.key)) as $by_kind
    | ($events | map(select(.kind == "derivation"))) as $drvs
    | ($drvs | map(select(.cache_hit)) | length)  as $hits
    | ($drvs | length)                            as $total
    | ($drvs | map(.elapsed // 0) | add // 0)     as $elapsed
    | ($drvs
        | group_by(.source // .archive // .output // "?")
        | map({ src: (.[0].source // .[0].archive // .[0].output // "?"),
                n:   (map(.built) | unique | length) })
        | map(select(.n > 1))
        | sort_by(-.n)) as $rebuilds
    | "=== events by kind ===", empty,
      ($by_kind | .[] | "  \(.key)  \(.n)"),
      "",
      (if $total > 0 then
         "=== derivations: \($total) total, \($hits) cache-hits "
           + "(\((100.0 * $hits / $total * 10 | floor / 10))%), "
           + "\($elapsed | . * 10 | floor / 10)s wall in derivation calls ==="
       else empty end),
      (if ($rebuilds | length) > 0 then
         "", "=== rebuilt sources (distinct outputs across log) ===",
         ($rebuilds | .[] | "  \(.n)× \(.src)")
       else empty end)
  ' "$log"
}

cmd_env() {
  local shims="$HERE/shims"
  printf 'export NIXGG_ROOT=%q\n' "$HERE"
  printf 'export PATH=%q:"$PATH"\n' "$shims"
  echo 'export CC=cc'
  echo 'export CXX=c++'
}

# ── Dispatch ───────────────────────────────────────────────────────

if (( $# == 0 )); then
  usage
  exit 2
fi

sub="$1"; shift
case "$sub" in
  run)    cmd_run    "$@" ;;
  eval)   cmd_eval   "$@" ;;
  force)  cmd_force  "$@" ;;
  build)  cmd_build  "$@" ;;
  emit)   cmd_emit   "$@" ;;
  stats)  cmd_stats  "$@" ;;
  env)    cmd_env         ;;
  -h|--help|help)  usage  ;;
  *)      echo "nixgg: unknown subcommand '$sub'" >&2; usage; exit 2 ;;
esac
